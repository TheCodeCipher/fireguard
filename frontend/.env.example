# FireGuard frontend settings (copy to .env.local). Nothing secret belongs here: everything
# prefixed VITE_ is compiled into the public JavaScript bundle. The FIRMS key lives ONLY in the
# backend's .env (FIRMS_MAP_KEY) and is never sent to the browser.

# Leave empty to use the dev-server proxy (/api -> backend). Set a full URL only when the
# frontend is served separately from the backend, e.g. http://127.0.0.1:8000
VITE_API_BASE=

# MapLibre style URL for the basemap. Empty = OpenStreetMap raster tiles (needs internet;
# the forecast layers still render without a basemap).
VITE_BASEMAP_STYLE=
