  "components": {
    "schemas": {
      "ArtifactDescriptor": {
        "properties": {
          "artifact_id": {
            "type": "integer",
            "title": "Artifact Id"
          },
          "artifact_type": {
            "type": "string",
            "title": "Artifact Type"
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "checksum_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checksum Sha256"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "artifact_id",
          "artifact_type",
          "url"
        ],
        "title": "ArtifactDescriptor"
      },
      "CacheMetadata": {
        "properties": {
          "status": {
            "type": "string",
            "pattern": "^(HIT|MISS|DISABLED)$",
            "title": "Status"
          },
          "ttl_seconds": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Ttl Seconds"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "status",
          "ttl_seconds"
        ],
        "title": "CacheMetadata"
      },
      "FIRMSAvailabilityResponse": {
        "properties": {
          "source": {
            "$ref": "#/components/schemas/FIRMSSource"
          },
          "min_date": {
            "type": "string",
            "format": "date",
            "title": "Min Date"
          },
          "max_date": {
            "type": "string",
            "format": "date",
            "title": "Max Date"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "title": "Retrieved At"
          },
          "cache": {
            "$ref": "#/components/schemas/CacheMetadata"
          }
        },
        "type": "object",
        "required": [
          "source",
          "min_date",
          "max_date",
          "retrieved_at",
          "cache"
        ],
        "title": "FIRMSAvailabilityResponse"
      },
      "FIRMSSource": {
        "type": "string",
        "enum": [
          "VIIRS_SNPP_NRT",
          "VIIRS_SNPP_SP",
          "VIIRS_NOAA20_NRT",
          "VIIRS_NOAA20_SP",
          "VIIRS_NOAA21_NRT",
          "VIIRS_NOAA21_SP"
        ],
        "title": "FIRMSSource"
      },
      "FireConfidence": {
        "type": "string",
        "enum": [
          "low",
          "nominal",
          "high",
          "unknown"
        ],
        "title": "FireConfidence"
      },
      "FireObservation": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "brightness": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brightness"
          },
          "frp": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Frp"
          },
          "confidence": {
            "$ref": "#/components/schemas/FireConfidence",
            "default": "unknown"
          },
          "confidence_raw": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence Raw"
          },
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "instrument": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instrument"
          },
          "acquisition_date": {
            "type": "string",
            "format": "date",
            "title": "Acquisition Date"
          },
          "acquisition_time": {
            "type": "string",
            "pattern": "^\\d{4}$",
            "title": "Acquisition Time"
          },
          "daynight": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Daynight"
          },
          "source": {
            "$ref": "#/components/schemas/FIRMSSource"
          },
          "product": {
            "type": "string",
            "title": "Product"
