FIREGUARD_APP_NAME=FireGuard API
FIREGUARD_APP_ENV=development
FIREGUARD_APP_VERSION=0.2.0
FIREGUARD_LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./fireguard_dev.db
FIRMS_MAP_KEY=
FIREGUARD_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov
FIREGUARD_FIRMS_TIMEOUT_SECONDS=20
FIREGUARD_FIRMS_OBSERVATION_CACHE_TTL_SECONDS=300
FIREGUARD_FIRMS_AVAILABILITY_CACHE_TTL_SECONDS=1800
FIREGUARD_ARTIFACT_ROOT=artifacts
FIREGUARD_REPLAY_SESSION_TTL_SECONDS=900
FIREGUARD_CORS_ORIGINS=["http://localhost:5173"]
